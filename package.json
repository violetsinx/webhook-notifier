{
  "name": "webhook-notifier",
  "version": "1.0.0",
  "description": "Receive webhooks and forward notifications to Discord and email",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "demo": "DRY_RUN=true node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/server.test.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "license": "MIT"
}
